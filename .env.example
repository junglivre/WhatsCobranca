# Run npm run bootstrap:env to CREATE .env; do not copy this placeholder file first.
# This file only documents the required shape; every value below is invalid.
POSTGRES_DB=whatscobranca
POSTGRES_USER=whatscobranca
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_BOOTSTRAP
DATABASE_URL=postgresql://whatscobranca:CHANGE_ME_GENERATE_WITH_BOOTSTRAP@postgres:5432/whatscobranca?schema=public
AUTOMATION_TOKEN=CHANGE_ME_GENERATE_WITH_BOOTSTRAP
WAHA_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_BOOTSTRAP
# Fill these four from your own WAHA instance/session. OPERATOR_LID/OPERATOR_PHONE
# must be the LITERAL identifiers your session sends as payload.from for the
# single authorized operator -- see README.md ("Por que @lid, não só o telefone").
WAHA_API_KEY=your-waha-admin-api-key
WAHA_BASE_URL=https://your-waha-instance.example.com
WAHA_SESSION=default
OPERATOR_LID=00000000000000@lid
OPERATOR_PHONE=5511999999999@c.us
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_BOOTSTRAP
# Audio (Fase 4): empty GROQ_API_KEY disables audio with a deterministic reply.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.3-70b-versatile
WAHA_MEDIA_MAX_BYTES=16777216
# Billing (Fase 6): 'none' desativa cobrança automática ('recebi' continua
# funcionando). 'asaas' exige ASAAS_API_KEY + ASAAS_WEBHOOK_TOKEN — o serviço
# não sobe sem elas (fail-fast). Sandbox: https://api-sandbox.asaas.com/v3.
BILLING_PROVIDER=none
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
# Efí Pay (Pix cob com txid; OAuth2; boleto não suportado pelo adapter).
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_KEY=
EFI_BASE_URL=https://api-sandbox.efipay.com.br
EFI_WEBHOOK_TOKEN=
# Produção Pix exige mTLS (ICP-Brasil): certificado/chave em base64.
EFI_CERT_BASE64=
EFI_KEY_BASE64=
# NFS-e: 'manual' = pendência para emissão humana; adapters reais na Fase 7.
INVOICE_PROVIDER=none
# Relatórios (Fase 8): fechamento diário + semanal no /automation/tick.
REPORTS_ENABLED=true
REPORT_DAILY_HOUR=18
REPORT_WEEKLY_DAY=1
